# Reference production endpoints. Copy into .env as needed; deployment overrides may also go in the untracked .env.local.
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# Public production OAuth client id, not a secret.
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# Source back-link base for import sessions; it does not change the API. Keep /cn/share - it contains no share code.
# When changing the API origin, update this value accordingly - or delete this entry to follow the API origin automatically. Never assign an empty value.
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# Full override URL for remote resources; must contain the version matching the running build. Delete this entry to derive it automatically from the version.
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# Optional path to a local Provider config file; leave it empty to use the built-in production config.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# Intranet or private-deployment endpoints have no production default; fill them in explicitly as needed.
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
