{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/scheduler",
    "rootDir": "src/scheduler",
    "lib": ["es2025"],
    // scheduler 只把 parentPort 当类型用、不 import "electron" 值；parentPort 的结构类型已在
    // src/scheduler/parentPortTypes.ts 本地声明，故只需 node 全局类型（process/setInterval）。
    "types": ["node"]
  },
  "include": ["src/scheduler"],
  // scheduler 直接依赖 services(node 入口)/shared；补 references 复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
