{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/scheduler",
    "rootDir": "src/scheduler",
    "lib": ["es2025"],
    // scheduler only uses Electron.MessageEvent as a type and does not import "electron" values,
    // so explicitly include node + electron global types (process/setInterval/Electron namespace).
    "types": ["node", "electron"]
  },
  "include": ["src/scheduler"],
  // scheduler directly depends on services (node entry)/shared; add references to reuse upstream declaration artifacts.
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
