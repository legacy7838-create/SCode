{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/host",
    "rootDir": "src/host",
    "lib": ["es2025"]
  },
  "include": ["src/host"],
  // host directly depends on services/shared and also directly imports rpc; adding references prevents it from pulling rpc source back in for checking.
  "references": [{ "path": "../shared" }, { "path": "../services" }, { "path": "../rpc" }]
}
