{
  "name": "@zcode/desktop",
  "private": true,
  "description": "ZCode Desktop App",
  "author": "ZCode",
  "type": "module",
  "scripts": {
    "dev:tauri": "concurrently -k -n tsup,vite,tauri \"tsup --watch\" \"vite dev\" \"tauri dev\"",
    "tauri:build": "pnpm build && tauri build",
    "build": "tsup && vite build",
    "prepare:build-meta": "node scripts/build-metadata.mjs",
    "prepare:runtime-assets": "node scripts/prepare-runtime-assets.mjs",
    "prepare:remote-assets": "node ../../scripts/prepare-prebuilds.mjs",
    "prepare:agent-bundle": "node scripts/prepare-agent-node-bundle.mjs",
    "prepare:native-search": "node ../../scripts/prepare-native-search-tools.mjs",
    "prepare:browser-import-helper": "node scripts/build-windows-browser-import-helper.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.5",
    "@fiahfy/icns": "^0.0.7",
    "@larksuiteoapi/node-sdk": "1.61.1",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.214.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.214.0",
    "@opentelemetry/resources": "2.6.1",
    "@opentelemetry/sdk-metrics": "2.6.1",
    "@opentelemetry/sdk-trace-base": "2.6.1",
    "@tauri-apps/api": "^2.12.1",
    "@zcode/client": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/rpc": "workspace:*",
    "@zcode/server": "workspace:*",
    "@zcode/services": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/ui": "workspace:*",
    "module-details-from-path": "^1.0.4",
    "node-forge": "^1.4.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "^7.7.4",
    "ssh2": "^1.16.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "http-mitm-proxy": "^1.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  },
  "productName": "ZCode"
}
