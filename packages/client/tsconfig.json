{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"]
  },
  "include": ["src"],
  // The client directly relies on rpc. If the rpc project is not explicitly referenced, typecheck will recompile the rpc source code along the workspace package entry.
  // After adding references, the client will give priority to reading the declaration file generated by rpc.
  "references": [{ "path": "../services" }, { "path": "../rpc" }]
}
