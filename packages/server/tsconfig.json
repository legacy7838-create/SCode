{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"]
  },
  "include": ["src"],
  // The server also directly imported shared/services/client/rpc.
  // Previously, references were incomplete, and the build would fall back to grabbing the source code along the package entry, causing rpc errors to be repeatedly amplified.
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../client" },
    { "path": "../rpc" }
  ]
}
