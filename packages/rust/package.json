{
  "name": "@zcode/rust",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./image": "./src/image.ts",
    "./git": "./src/git.ts",
    "./diff": "./src/diff.ts",
    "./codec": "./src/codec.ts",
    "./coalesce": "./src/coalesce.ts",
    "./projection": "./src/projection.ts",
    "./events": "./src/events.ts",
    "./reassembly": "./src/reassembly.ts",
    "./assembler": "./src/assembler.ts",
    "./event-coalescer": "./src/eventCoalescer.ts",
    "./markdown": "./src/markdown.ts",
    "./protocol": "./src/protocol.ts",
    "./channel": "./src/channel.ts",
    "./chunkstream": "./src/chunkstream.ts",
    "./profiles": "./src/profiles.ts",
    "./rpc-buffer": "./src/rpcBuffer.ts",
    "./rpc-utils": "./src/rpcUtils.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:native": "bash scripts/build-native.sh",
    "build:packaging": "cargo build --release -p zcode-packaging",
    "gen:targets": "cargo run -p zcode-packaging -- gen-targets",
    "check:targets": "cargo run -p zcode-packaging -- gen-targets --check",
    "native:inventory": "cargo run -p zcode-packaging -- inventory",
    "native:stage-desktop": "cargo run -p zcode-packaging -- plan --target host --surface desktop-agent --out target/desktop-agent-plan.json && cargo run -p zcode-packaging -- stage --plan target/desktop-agent-plan.json",
    "native:verify-desktop": "cargo run -p zcode-packaging -- verify --plan target/desktop-agent-plan.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
