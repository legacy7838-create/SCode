{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025"],
    "types": ["node"]
  },
  "include": ["src"],
  // Previously, no project reference to rpc was declared, so tsc would check rpc as a regular source dependency repeatedly, causing errors to appear across multiple consumers.
  // Adding references here lets services consume rpc's declaration output directly.
  "references": [{ "path": "../shared" }, { "path": "../rpc" }]
}
