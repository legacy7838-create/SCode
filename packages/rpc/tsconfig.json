{
  // This is changed to composite project because in the past, consumers would directly drag in the rpc source code along the package export and check it repeatedly.
  // After changing to an independent project that can be consumed by project references, typecheck will give priority to reusing the declaration products generated by rpc itself to prevent the same batch of errors from being enlarged and printed.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    // Reason for fix: The old @types/css-font-loading-module that rrweb transitively depends on will duplicate the built-in DOM declaration of the new TypeScript.
    // rpc did not inherit the root tsconfig, and the third-party declaration check was not skipped before, causing bootstrap to fail on dependency type conflicts.
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    // The Node-only `./native` binding compiles the @zcode/rust loader source, which uses
    // node:fs/node:path/node:module/node:url plus __filename. Without this the loader fails to
    // resolve Node globals when it is checked inside the rpc program.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Consume the @zcode/rust declaration output instead of re-checking its sources on every build.
  "references": [{ "path": "../rust" }]
}
