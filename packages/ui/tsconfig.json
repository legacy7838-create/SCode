{
  "extends": "../../tsconfig.base.json",
  // The ui package follows NodeNext ESM resolution rules; intra-package imports must resolve directly to real file paths.
  // Previously ai-elements both self-referenced @zcode/ui/... from within the package and omitted internal .js extensions in many places,
  // which would simultaneously hit package exports restrictions and NodeNext path resolution failures.
  // Here we keep the existing config and unify intra-package imports to relative paths with .js extensions, avoiding inconsistencies between dev, build, and type-check results.
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // In certain tsserver/incremental project states, directory-style include ("src") can result in new files that exist
  // and are expanded by CLI `tsc --showConfig`, but the editor still briefly reports "file is not in project file list".
  // Here we switch to explicit globs to reliably include ts/tsx/d.ts source files under the ui package in the project, avoiding new modules like settings page helper files being incorrectly excluded.
  // We also include .json under src (such as provider-icons data under assets) so that resolveJsonModule imports are included in the project file list.
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.json"],
  // The ui package also directly uses rpc types; after adding the project reference, ui will no longer re-check rpc source as its own input.
  "references": [
    { "path": "../provider" },
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" }
  ]
}
