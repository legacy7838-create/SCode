node_modules/
dist/
# zcode-server-cli 发行包 staging 输出，本地组装产物不入库。
dist-release/
# macOS CI 按架构隔离 electron-builder 输出目录，这些仍是构建产物。
packages/desktop/dist-*/
out/
prebuilds/
bundled-resources/
mock-cdn/
packages/desktop/bundled-resources/
packages/desktop/bundled-agents/
packages/desktop/bundled-tools/
packages/desktop/mock-cdn/
*.tsbuildinfo
.DS_Store
coverage/
.env.local
.env.*.local
.env
.VSCodeCounter
.idea/
.zed/
.cache
# CI 会跨任务保留这些下载缓存；不应进入 Git 未跟踪源码枚举。
/.electron-builder-cache/
/.electron-cache/
/.pnpm-store/
/.npm-cache/
.turbo/
z-work/
openclaw/
.run-logs/
.worktrees/
packages/stream-animate/dist-server/
packages/stream-animate/.stream-animate-data/
.codegraph
.mimosa/
# 集成分支曾混入 node-gyp 构建产物与 .playwright-mcp 临时快照；
# 入库由 scripts/ci/ci-repo-hygiene.mjs 在 CI 第一站拒绝，这里让本地 git add 也忽略它们。
.playwright-mcp/
*.o
.deps/
obj.target/
config.gypi
gyp-mac-tool
*.target.mk
binding.Makefile
# 这两条原来写成 build/Makefile、build/Release/*.node，含中间斜杠的 pattern
# 只相对 .gitignore 所在目录（仓库根）生效，匹配不到 packages/ax-macos/build/ 下的产物；
# 而 ci-repo-hygiene.mjs 的 denylist 用的是 (^|/)build/... 任意层级匹配。
# 宽严不一致时无斜杠 pattern 能拦住的产物会被 git add -A 重新扫进索引。
# 加 **/ 让忽略范围与门禁范围对齐。
**/build/Makefile
**/build/Release/*.node

# Rust native-boundary 产物（spec/native-boundary-*.md）：全部可由
# packages/desktop/scripts/prepare-zcode-*.mjs 重建，源码入库、产物不入库。
# 逐 crate 写死路径而不是通用 `target/`，是为了不误伤仓库里其它语言的构建目录。
packages/desktop/zcode-db/target/
packages/desktop/zcode-pty/target/
packages/desktop/zcode-scan/target/
packages/desktop/zcode-score-wasm/target/
packages/desktop/zcode-diff-wasm/target/
packages/desktop/zcode-appimage-strip/target/
packages/desktop/src-tauri/target/
# wasm-pack / prepare-zcode-score-wasm.mjs 暂存的胶水代码与 payload。
# 胶水与 <out-name>_bg.wasm 是**文件名耦合**的一对（nodejs 胶水按 __dirname 相对读取），
# 因此两者必须一起重建、一起忽略，绝不能只入库其中一个。
packages/desktop/zcode-score-wasm/pkg/
packages/desktop/zcode-score-wasm/zcode_score.wasm
packages/desktop/zcode-score-wasm/zcode_score_web_bg.wasm
# prepare-zcode-diff-wasm.mjs 暂存的胶水与 payload（同样文件名耦合，一起重建、一起忽略）。
packages/desktop/zcode-diff-wasm/pkg/
packages/desktop/zcode-diff-wasm/zcode_diff.wasm
packages/desktop/zcode-diff-wasm/zcode_diff_web_bg.wasm
# napi addon（stagedPath，由 prepare-*-native.mjs 从 cargo 产物拷贝而来）
packages/desktop/zcode-db/zcode_db.node
packages/desktop/zcode-pty/zcode_pty.node
packages/desktop/zcode-scan/zcode_scan.node

# CUA 权限浮窗吸附用的 Swift 辅助二进制（由 prepare:macos-window-bounds 从
# packages/desktop/native/macos-window-bounds/main.swift 编出，源码入库、产物不入库）
packages/desktop/resources/macos-window-bounds/
# CUA Helper SEA 基座下载缓存（scripts/cua-helper-sea-base.mjs 落盘的官方 Node 22 运行时，纯下载产物）
/.tmp/
# Python 字节码（docker/plugin-eval/summarize.py 在主机上跑会生成）。
__pycache__/
*.pyc

# 本地工具运行产物，均可再生：桌面端 e2e 的截图/缓存/网络抓包，以及桌面
# 开发运行器的 Electron 下载缓存。
packages/desktop/.e2e-artifacts/
packages/desktop/.e2e-cache/
packages/desktop/.e2e-network-capture/
.zcode-runtime/

# Qoder agent 的本地 scratch worktree（含整棵 checkout + 自己的 node_modules，约 23GB）。
# 必须靠 .gitignore 生效：oxlint/oxfmt 的 ignorePatterns 对它无效（嵌套 node_modules 的
# symlink 解析后 realpath 落到 .qoder 之外，配置里的 .qoder/** 匹配不到），
# 不忽略的话 oxlint 会扫 5.4 万个文件、耗时 275s 且被无关代码刷出一堆 error。
.qoder/

# tsc 就地 emit 产物：schedulerProtocol.ts 与它的 .js/.d.ts/.*.map 并排落在 src/ 下。
# 只忽略 emit 出来的同目录兄弟文件，schedulerProtocol.ts 本体照常入库。
packages/desktop/src/scheduler/*.js
packages/desktop/src/scheduler/*.js.map
packages/desktop/src/scheduler/*.d.ts
packages/desktop/src/scheduler/*.d.ts.map

# 仓库根的 shell 重定向事故产物（`pnpm list > pnpm` 之类会留下 0 字节同名文件）。
/concurrently
/pnpm
/zcode@*
