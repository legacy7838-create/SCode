{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // tauriBridge.ts 是 renderer 侧对每个 #[tauri::command] 的一一映射封装（~104 个 invoke 包装），
      // 属于机械转发而非复杂业务逻辑；且 layer-a 的 a5-contract 测试会按“单文件”解析本文件的 invoke()
      // 名单来和 commands.rs 做 1:1 校验，拆分文件会破坏该契约扫描。因此对本文件单独关闭 max-lines，
      // 不影响其它业务代码的 400 行约束。
      "files": ["**/tauriBridge.ts"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // apps/zcode-cli（Agent CLI 运行时，1217 个 TS 文件）此前被 ignorePatterns 整目录排除在
      // lint 之外，等于本仓库最大的代码面（264K 行）从未被 lint 覆盖。现已改为纳入检查，
      // 只对其关闭 max-lines，**其余所有规则照常生效**。
      //
      // 为什么单独关 max-lines：该目录确实存在 74 个超长文件的历史债务（contracts/core/adapters/
      // bootstrap 下的 gateway、runner、transcript-hydration 等）。一次性拆分这些文件属于独立的
      // 重构工作，与本次「修正门禁配置」不是同一件事，硬塞进来会让本次变更无法审阅。
      //
      // 这里用 scoped override 而不是恢复整目录 ignore，是刻意的：ignore 会连同 no-unused-vars
      // 等规则一起关掉（当前该目录有 63 条 no-unused-vars 警告本应被看到）；override 只放宽行数，
      // 让债务显式可见，同时保留其余 lint 信号。拆分完成后删掉本条 override 即可恢复 400 行约束。
      "files": ["apps/zcode-cli/**/*.ts", "apps/zcode-cli/**/*.tsx"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    ".qoder/**",
    "packages/formal-proof"
  ]
}
