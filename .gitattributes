# Keep script files LF-terminated so Windows CRLF cannot break shebang parsing
*.mjs text eol=lf
*.sh  text eol=lf

# The upstream license text and the generated notices are kept byte-for-byte: do not convert line endings or trim whitespace.
# License / ======= in the original text is a Markdown heading, not a merge conflict.
THIRD-PARTY-NOTICES.md -text -whitespace conflict-marker-size=32 linguist-generated=true
third-party/upstream/** -text -whitespace
third-party/native-search/licenses/** -text -whitespace
third-party/runtime/*.txt -text -whitespace
third-party/inventory.json linguist-generated=true
